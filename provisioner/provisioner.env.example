# 64+ random characters, stored only on the VPN host
FREE_RUS_PROVISIONER_TOKEN=replace-with-a-long-random-token
FREE_RUS_INTERFACE=awg0
FREE_RUS_CONFIG=/etc/amnezia/amneziawg/awg0.conf
FREE_RUS_DATA_DIR=/var/lib/free-rus-vpn
FREE_RUS_ENDPOINT=YOUR_VPN_HOSTNAME_OR_IP:39547
FREE_RUS_POOL=10.8.0.0/24
FREE_RUS_BIND=127.0.0.1
FREE_RUS_PORT=8786
